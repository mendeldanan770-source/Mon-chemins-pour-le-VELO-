<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mes deux chemins</title>
<style>
  body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #dff3ff;
    color: #17384a;
  }
  .page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 25px;
  }
  h1 {
    text-align: center;
    font-size: 32px;
    font-weight: 900;
  }
  .photo-box {
    text-align: center;
    margin: 15px 0 25px;
  }
  .photo-box label {
    display: inline-block;
    background: white;
    border: 2px solid #9bc9df;
    border-radius: 10px;
    padding: 10px 16px;
    cursor: pointer;
    font-weight: bold;
  }
  #photoInput { display: none; }
  .path {
    background: white;
    border-radius: 16px;
    padding: 18px;
    margin: 20px 0;
    box-shadow: 0 2px 8px rgba(0,0,0,.08);
  }
  h2 {
    text-align: center;
    font-size: 24px;
    font-weight: 900;
    margin: 0 0 15px;
  }
  .track-scroll {
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .track {
    display: flex;
    gap: 3px;
    min-width: 1180px;
    align-items: center;
  }
  .cell {
    width: 25px;
    height: 40px;
    flex: 0 0 25px;
    border: 2px solid #a9d4e7;
    border-radius: 5px;
    background: #f8fcff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: bold;
  }
  .cell.active {
    background: #bfe8fb;
    border-color: #4f9dc8;
  }
  .avatar {
    font-size: 24px;
  }
  .bike {
    font-size: 23px;
  }
  .controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 15px;
  }
  button {
    padding: 12px 20px;
    border-radius: 10px;
    border: 2px solid #9bc9df;
    background: #eaf8ff;
    color: #17384a;
    font-size: 15px;
    font-weight: 900;
    cursor: pointer;
  }
  button:hover {
    background: #cceeff;
  }
  .status {
    text-align: center;
    font-weight: bold;
    margin-top: 10px;
    min-height: 20px;
  }
  .help {
    text-align: center;
    font-size: 14px;
    margin-bottom: 10px;
  }
</style>
</head>
<body>
<div class="page">
  <h1>MES DEUX CHEMINS</h1>

  <div class="photo-box">
    <label for="photoInput">📷 Mettre ma photo</label>
    <input id="photoInput" type="file" accept="image/*">
    <div class="help">Choisis une photo de ta tête : elle remplacera le personnage 👤.</div>
  </div>

  <div class="path">
    <h2>MAAMAR MENDEL</h2>
    <div class="track-scroll"><div class="track" id="track0"></div></div>
    <div class="controls">
      <button type="button" onclick="move(0,-1)">⬅ RECULER</button>
      <button type="button" onclick="move(0,1)">AVANCER ➡</button>
    </div>
    <div class="status" id="status0"></div>
  </div>

  <div class="path">
    <h2>COMPORTEMENT GÉNÉRAL</h2>
    <div class="track-scroll"><div class="track" id="track1"></div></div>
    <div class="controls">
      <button type="button" onclick="move(1,-1)">⬅ RECULER</button>
      <button type="button" onclick="move(1,1)">AVANCER ➡</button>
    </div>
    <div class="status" id="status1"></div>
  </div>
</div>

<script>
const total = 40;
const positions = [0, 0];
let photoURL = null;

function draw(path) {
  const track = document.getElementById("track" + path);
  track.innerHTML = "";

  for (let i = 0; i < total; i++) {
    const cell = document.createElement("div");
    cell.className = "cell" + (i === positions[path] ? " active" : "");

    if (i === positions[path]) {
      if (photoURL) {
        const img = document.createElement("img");
        img.src = photoURL;
        img.alt = "Ma photo";
        img.style.width = "30px";
        img.style.height = "30px";
        img.style.objectFit = "cover";
        img.style.borderRadius = "50%";
        cell.appendChild(img);
      } else {
        cell.innerHTML = '<span class="avatar">👤</span>';
      }
    } else if (i === total - 1) {
      cell.innerHTML = '<span class="bike">🚲</span>';
    } else {
      cell.textContent = i + 1;
    }

    track.appendChild(cell);
  }

  document.getElementById("status" + path).textContent =
    positions[path] === total - 1
      ? "🎉 Arrivée !"
      : "Case " + (positions[path] + 1) + " / 40";
}

function move(path, amount) {
  positions[path] = Math.max(0, Math.min(total - 1, positions[path] + amount));
  draw(path);
}

document.getElementById("photoInput").addEventListener("change", function(e) {
  const file = e.target.files[0];
  if (!file) return;
  if (photoURL) URL.revokeObjectURL(photoURL);
  photoURL = URL.createObjectURL(file);
  draw(0);
  draw(1);
});

draw(0);
draw(1);
</script>
</body>
</html>
